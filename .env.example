# ---------- Embedding（二选一厂商）----------
# siliconflow | dashscope | bailian（bailian 等同 dashscope）
EMBEDDING_PROVIDER=siliconflow

# 向量维度，须与 supabase/sql/init.sql 中 vector(N) 一致（默认 1024）
EMBEDDING_DIM=1024
# 兼容旧名；未设 EMBEDDING_DIM 时仍可读取此项
# SILICONFLOW_EMBEDDING_DIM=1024

# --- SiliconFlow ---
SILICONFLOW_API_KEY=""
# 未设置或仅空白时使用默认 https://api.siliconflow.cn/v1/embeddings
SILICONFLOW_EMBEDDING_ENDPOINT="https://api.siliconflow.cn/v1/embeddings"
# 留空则使用默认 BAAI/bge-m3
SILICONFLOW_EMBEDDING_MODEL="BAAI/bge-m3"

# --- 阿里云百炼 / DashScope（EMBEDDING_PROVIDER=dashscope 或 bailian 时必填）---
# DASHSCOPE_API_KEY=""
# 默认中国大陆 compatible-mode；国际站示例：https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_EMBEDDING_BASE_URL=
# DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# ---------- Supabase ----------
# 必须与下一行的 service_role 来自同一项目：Dashboard → Project Settings → API，同一页复制
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""


# 可选别名（与 lib/supabase/server.ts 一致）；若设置，仍需与上面 URL 同属一个项目
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

NEXT_PUBLIC_ADMIN_SECRET=""


# admin/sync · admin/ingest（服务端 only · 勿用 NEXT_PUBLIC_ 前缀）
# 与 Python 侧 admin 鉴权同值；文档 shell 别名 ADMIN_TOKEN
SYNC_ADMIN_SECRET=""

RAG_MATCH_THRESHOLD=0.3

# PY_API_URL="https://ai-ink-brain-api-python.vercel.app/"

# ---------- Ops Desk（site_mode=ops）----------
# 站点模式：portfolio | development | ops（未设或非法值等同 development）
# 启用 Ops Desk 时须设为 ops，并配置 OPS_DESK_SECRET
NEXT_PUBLIC_SITE_MODE=development

# Ops Desk M0 邀请制秘钥（viewer；未设 OPS_DESK_MAINTAINER_SECRET 时也具备 maintainer 能力）
OPS_DESK_SECRET=""
# OPS_DESK_MAINTAINER_SECRET=""
# cookie 有效期（小时）；未设或 <=0 为 session cookie
# OPS_DESK_SESSION_TTL_HOURS=24
# 面试一次性 Demo token（可选，仅 viewer）
# OPS_DESK_DEMO_TOKEN=""
# 手动触发 GitHub Actions sync 用 token（P2）
# OPS_DESK_GITHUB_TOKEN=""

# 演示对话解锁（推荐 · 运维主路径）
# 后端 ai-ink-brain-api-python：docs/diary/local_chatbi_access_token_gen.py
# → INSERT chatbi_access_tokens → 邮件发「明文 token」（可设 expires_at）
# portfolio / development 均在 /unified-chat 粘贴 token，经 Python access/verify

# 可选 legacy（W3 · 一般不必配置；portfolio 已改走 ChatBI token）
# tools/gen-portfolio-secrets.sh · visitor 72h / visitor-admin 24h Cookie
# PORTFOLIO_VISITOR_SECRET=
# PORTFOLIO_VISITOR_ADMIN_SECRET=