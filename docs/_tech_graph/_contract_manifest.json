{
  "schema_version": "tech_graph_contract_manifest_v1",
  "repo": "ai-ink-brain",
  "topic": "unified_chat_sse_contract",
  "_note": "Ink 消费镜像：键名须与配对后端 ai-ink-brain-api-python/docs/_tech_graph/_contract_manifest.json 一致（双 PR 互锁）。2026-05-31 C1：agent.plan.preview 按 tool 分支（text2sql_query vs rag_search）。",
  "sse": {
    "_required": {
      "envelope_keys": ["event", "data"],
      "allowed_events": ["chain", "done"],
      "chain.data_keys": ["type", "ts", "step_id", "payload"],
      "done.data_keys": ["ok", "mode", "run_id", "session_id", "request_id"],
      "chain.payload_min_keys_by_type.must_include": ["rag.sources", "sql.result"]
    },
    "envelope_keys": ["event", "data"],
    "allowed_events": ["chain", "done"],
    "chain": {
      "_note": "chain 事件：data 是统一结构，type 决定 payload 形态。frontend_optional_chain_data_keys 是允许前端额外读取但不要求后端必出（用于兼容字段）。frontend_ts_ignore_payload_like_keys：TS 里 ExecSection / transcript.map(row) 等 UI 字段及 done 上可选 persist，易被 contract_check 的 obj.* 与 .map 启发式误扫。",
      "data_keys": ["type", "ts", "step_id", "payload"],
      "frontend_optional_chain_data_keys": ["step"],
      "frontend_ts_ignore_payload_like_keys": [
        "kind",
        "finalMode",
        "dropped",
        "snippet",
        "assistant",
        "latencyMs",
        "persist",
        "persistHint",
        "toolError",
        "user",
        "phaseId",
        "phaseKind",
        "text2sqlPhasesMs",
        "text2sql_phases_ms",
        "name",
        "target",
        "slice",
        "warningsLines",
        "rewriteQuery",
        "plannedTopK",
        "previewHeadlines"
      ],
      "type_values": [
        "meta",
        "router.decision",
        "router.evidence",
        "router.evidence.details",
        "tool.call.start",
        "tool.call.end",
        "rag.query_expand",
        "rag.sources",
        "sql.result",
        "assistant.message",
        "latency",
        "error",
        "agent.step.start",
        "agent.think",
        "agent.clarify",
        "agent.plan.preview",
        "agent.intent",
        "agent.step.end",
        "agent.final",
        "agent.llm.start",
        "agent.llm.delta",
        "agent.llm.end",
        "agent.llm.truncated",
        "text2sql.phase.start",
        "text2sql.phase.end"
      ],
      "payload_min_keys_by_type": {
        "_note": "每个 type 的 payload 最小必需键集合：后端必须至少提供这些键；前端不得读取 manifest 未承诺的键。",
        "meta": ["run_id", "mode", "session_id"],
        "router.decision": ["prefer", "candidate_mode", "final_mode", "rule_hits", "evidence", "fallback"],
        "router.evidence": ["candidate_mode", "final_mode", "fallback", "ddl", "fts"],
        "router.evidence.details": ["candidate_mode", "final_mode", "fallback", "thresholds", "ddl_candidates", "fts_candidates"],
        "tool.call.start": ["tool", "input"],
        "tool.call.end": ["output", "error", "latency_ms"],
        "rag.query_expand": ["raw", "rewrite"],
        "rag.sources": {
          "_note": "rag.sources 的 payload 为 sources+retrieval；source_item_keys 为 sources[] 每一项的最小键名集合。",
          "payload_keys": ["sources", "retrieval"],
          "source_item_keys": ["id", "content", "filename", "score", "path", "url"],
          "retrieval_keys": ["top_k", "rrf_k"]
        },
        "sql.result": ["sql", "columns", "rows", "truncated"],
        "assistant.message": ["role", "content"],
        "latency": ["total_ms", "stages_ms"],
        "error": ["stage", "message"],
        "agent.step.start": ["step_number", "max_steps"],
        "agent.think": ["step_number", "thought", "selected_tool", "mode", "confidence"],
        "agent.clarify": ["step_number", "message", "prompt_for_user"],
        "agent.plan.preview": {
          "_note": "C1@2026-05-31 扁平键：payload_keys 为各 tool 公共键。text2sql_query 额外 sql_draft；rag_search 额外 rewrite_query（planned_top_k、preview_headlines 可选）。",
          "payload_keys": ["plan_id", "tool", "warnings", "plan_execution_token", "expires_in_sec"],
          "text2sql_tool_values": ["text2sql_query"],
          "text2sql_extra_keys": ["sql_draft"],
          "rag_tool_values": ["rag_search"],
          "rag_extra_keys": ["rewrite_query"],
          "rag_optional_keys": ["planned_top_k", "preview_headlines", "sql_draft"]
        },
        "agent.intent": ["tool", "mode", "reasoning", "confidence", "fallback", "cache", "cache_key_hash", "latency_ms"],
        "agent.step.end": ["step_number", "tool_used", "mode", "success", "next_action"],
        "agent.final": ["total_steps", "tools_used", "modes", "fallback_used"],
        "agent.llm.start": ["phase", "step_id"],
        "agent.llm.delta": ["text", "part_index"],
        "agent.llm.end": ["ok", "phase", "step_id"],
        "agent.llm.truncated": ["dropped_chars", "reason"],
        "text2sql.phase.start": ["subphase_id", "phase_id", "phase_kind"],
        "text2sql.phase.end": ["subphase_id", "phase_id", "latency_ms"]
      }
    },
    "done": {
      "_note": "done 事件：表示一次请求结束；data_keys 为最小必需键（前端依赖这些键用于收尾与状态同步）。",
      "data_keys": ["ok", "mode", "run_id", "session_id", "request_id"]
    }
  },
  "frontend_anchors": {
    "_note": "锚点仅用于定位前端消费点与 BFF 透传点；不作为强耦合校验输入（校验主要针对键名/枚举集合）。",
    "sse_consumer_files": ["components/unified-chat/UnifiedChatPageClient.tsx"],
    "next_bff_proxy_files": ["app/api/py/unified/chat/stream/route.ts"]
  }
}
